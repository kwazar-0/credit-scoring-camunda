# Copy to Pulumi.dev.yaml (or your stack) and set project.
# stackRole: legacy | infra-core | infra-data | infra-runtime
config:
  gcp:project: my-gcp-project
  credit-scoring:region: europe-central2
  credit-scoring:stackRole: legacy
  credit-scoring:clusterName: hbg-gke
  # For infra-data with private Cloud SQL (after infra-core is up):
  # credit-scoring:stackRole: infra-data
  # credit-scoring:coreStackRef: myorg/credit-scoring-infra/dev-core
  # credit-scoring:createCloudSql: "true"
  # credit-scoring:cloudSqlInstanceName: postgres-instance
  # For infra-runtime (GKE) after core — Vertex (Gemini) + Cloud SQL client GSAs and WI:
  # credit-scoring:stackRole: infra-runtime
  # credit-scoring:coreStackRef: myorg/credit-scoring-infra/dev-core
  # Optional GKE node boot disk (pet defaults: 25 GB pd-standard — low SSD quota use):
  # credit-scoring:gkeNodeDiskGb: "25"
  # credit-scoring:gkeNodeDiskType: pd-standard
  # GKE autoscaling (infra-runtime): gkeMinNodes / gkeMaxNodes apply to the node pool.
  # On a REGIONAL cluster the autoscaler may spread nodes across zones; raising counts
  # can hit CPUS_ALL_REGIONS quickly (e.g. e2-standard-4 × many nodes). Prefer a quota
  # check before raising max. Changing only min/max should NOT replace the cluster; if
  # `pulumi up` proposes replacing `gcp:container:Cluster`, stop and fix provider drift
  # (e.g. refresh) rather than losing the node pool. Cluster deletion_protection in GCP
  # can leave the control plane up with no pool if a replace is attempted mid-flight.
  # credit-scoring:gkeMinNodes: "1"
  # credit-scoring:gkeMaxNodes: "3"
  # credit-scoring:vertexWorkloadIdentities: hbg:backend-ksa,hbg:worker-ksa
  # credit-scoring:cloudSqlWorkloadIdentities: camunda-dev:hbg-camunda-operate,camunda-ref:hbg-camunda-operate,camunda-prod:hbg-camunda-operate
